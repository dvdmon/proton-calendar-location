{
  "manifest_version": 3,
  "name": "Proton Calendar Location Enhancer",
  "version": "0.1.0",
  "description": "Adds location search and map links to Proton Calendar.",
  "content_scripts": [
    {
      "matches": ["https://calendar.proton.me/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["https://photon.komoot.io/*"]
}
